<Page x:Class="RevCopilot.UI.CopilotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:RevCopilot.UI"
      xmlns:models="clr-namespace:RevCopilot.Models"
      Background="#12122A"
      Foreground="#E8E8FF">

    <Page.Resources>
        <local:BoolToVisibilityConverter   x:Key="BoolToVis"/>
        <local:InverseBoolConverter        x:Key="InverseBool"/>
        <local:RoleToBubbleBrushConverter  x:Key="RoleToBubble"/>
        <local:RoleToAlignmentConverter    x:Key="RoleToAlign"/>
        <local:RoleToLabelConverter        x:Key="RoleToLabel"/>
        <local:RoleToLabelVisibilityConverter x:Key="RoleToLabelVis"/>

        <!-- ── Scrollbar ── -->
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ── Primary button ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="#7B61FF"/>
            <Setter Property="Foreground"   Value="#FFFFFF"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9880FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A3A5C"/>
                    <Setter Property="Foreground" Value="#6C6C99"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Ghost button ── -->
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="#ABABD6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A5C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Chat input ── -->
        <Style x:Key="ChatInput" TargetType="TextBox">
            <Setter Property="Background"               Value="#1E1E3C"/>
            <Setter Property="Foreground"               Value="#E8E8FF"/>
            <Setter Property="CaretBrush"               Value="#7B61FF"/>
            <Setter Property="BorderBrush"              Value="#3A3A5C"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="12,10"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="AcceptsReturn"            Value="True"/>
            <Setter Property="TextWrapping"             Value="Wrap"/>
            <Setter Property="MaxHeight"                Value="100"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ── ComboBox ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"    Value="#1E1E3C"/>
            <Setter Property="Foreground"    Value="#E8E8FF"/>
            <Setter Property="BorderBrush"   Value="#3A3A5C"/>
            <Setter Property="Padding"       Value="8,6"/>
        </Style>

        <!-- ── TextBox (settings) ── -->
        <Style x:Key="SettingsInput" TargetType="TextBox">
            <Setter Property="Background"      Value="#1E1E3C"/>
            <Setter Property="Foreground"      Value="#E8E8FF"/>
            <Setter Property="BorderBrush"     Value="#3A3A5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="CaretBrush"      Value="#7B61FF"/>
        </Style>

        <!-- ── Message bubble DataTemplate ── -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type models:ChatMessage}">
            <StackPanel Margin="8,4"
                        HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlign}}">

                <!-- Sender label -->
                <TextBlock Text="{Binding Role, Converter={StaticResource RoleToLabel}}"
                           Visibility="{Binding Role, Converter={StaticResource RoleToLabelVis}}"
                           Foreground="#7B61FF"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="4,0,4,2"/>

                <!-- Bubble -->
                <Border Background="{Binding Role, Converter={StaticResource RoleToBubble}}"
                        CornerRadius="12"
                        Padding="12,8"
                        MaxWidth="380">
                    <TextBlock Text="{Binding Content}"
                               Foreground="#E8E8FF"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </Border>

                <!-- Timestamp -->
                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}"
                           Foreground="#5C5C8A"
                           FontSize="10"
                           Margin="4,2,4,0"
                           HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlign}}"/>
            </StackPanel>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- messages -->
            <RowDefinition Height="Auto"/>   <!-- typing indicator -->
            <RowDefinition Height="Auto"/>   <!-- input row -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             HEADER
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0E0E22" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Copilot logo dot -->
                <Ellipse Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7B61FF" Offset="0"/>
                            <GradientStop Color="#38B2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Title + user info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Microsoft 365 Copilot" FontSize="15"
                               FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock x:Name="UserInfoText"
                               Text="Not signed in"
                               FontSize="10"
                               Foreground="#7B7BAA"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Settings toggle -->
                <Button Grid.Column="2" Content="⚙ Settings"
                        Style="{StaticResource GhostBtn}"
                        Margin="0,0,6,0"
                        Click="Settings_Click"/>

                <!-- New chat -->
                <Button Grid.Column="3" Content="+ New"
                        Style="{StaticResource GhostBtn}"
                        Click="NewChat_Click"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             SETTINGS PANEL (overlay, collapsible)
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#0E0E22"
                Panel.ZIndex="10"
                Margin="0,52,0,0"
                Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <TextBlock Text="Settings" FontSize="18" FontWeight="Bold"
                               Foreground="#7B61FF" Margin="0,0,0,16"/>

                    <!-- Azure AD Client ID -->
                    <TextBlock Text="Azure AD Client ID:" Foreground="#ABABD6" Margin="0,0,0,4"/>
                    <TextBox x:Name="ClientIdBox"
                             Style="{StaticResource SettingsInput}"
                             Margin="0,0,0,4"/>
                    <TextBlock Foreground="#5C5C8A" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Register an app in portal.azure.com → Azure Active Directory → App registrations.&#xa;Platform: Mobile and desktop apps | Redirect URI: http://localhost&#xa;Permissions: User.Read, Chat.ReadWrite, offline_access"/>

                    <!-- Tenant ID -->
                    <TextBlock Text="Tenant ID (optional):" Foreground="#ABABD6" Margin="0,0,0,4"/>
                    <TextBox x:Name="TenantIdBox"
                             Style="{StaticResource SettingsInput}"
                             Margin="0,0,0,4"/>
                    <TextBlock Foreground="#5C5C8A" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Leave blank or enter 'common' for multi-tenant/personal accounts.&#xa;Enter your organisation's tenant GUID to restrict sign-in to your company."/>

                    <!-- Agent selector -->
                    <TextBlock Text="Copilot Agent:" Foreground="#ABABD6" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AgentComboBox"
                                  Grid.Column="0"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,6,0"
                                  SelectionChanged="AgentComboBox_SelectionChanged"/>
                        <Button Grid.Column="1" Content="↻ Refresh"
                                Style="{StaticResource GhostBtn}"
                                Click="RefreshAgents_Click"/>
                    </Grid>
                    <TextBlock Foreground="#5C5C8A" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,20"
                               Text="Select 'M365 Copilot (Business Chat)' for the default assistant, or choose a Copilot Studio agent from your tenant."/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Save &amp; Sign In"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="0,0,8,0"
                                Click="SaveSettings_Click"/>
                        <Button Content="Sign Out"
                                Style="{StaticResource GhostBtn}"
                                Click="SignOut_Click"/>
                    </StackPanel>

                    <Button Content="✕ Close Settings"
                            Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Left"
                            Click="Settings_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             SIGN-IN PROMPT (shown when not signed in)
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Visibility="{Binding IsSignInPromptVisible, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="#1A1A38"
                CornerRadius="16"
                Padding="32,24"
                MaxWidth="320">
            <StackPanel>
                <!-- Gradient orb -->
                <Ellipse Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7B61FF" Offset="0"/>
                            <GradientStop Color="#38B2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="Microsoft 365 Copilot"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#E8E8FF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Sign in with your Microsoft 365 account to chat with Copilot and your agents."
                           FontSize="12"
                           Foreground="#7B7BAA"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>
                <Button Content="Sign in with Microsoft"
                        Style="{StaticResource PrimaryBtn}"
                        HorizontalAlignment="Center"
                        Click="SignIn_Click"/>
                <TextBlock Text="⚙ Configure Azure AD app in Settings first"
                           FontSize="10"
                           Foreground="#5C5C8A"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             MESSAGES LIST
        ══════════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="ChatScrollViewer"
                      Grid.Row="1"
                      Visibility="{Binding IsSignInPromptVisible,
                                           Converter={StaticResource BoolToVis},
                                           ConverterParameter=inverse}">
            <!-- Note: inverting done in code-behind via Collapsed/Visible toggling -->
            <ItemsControl x:Name="MessagesPanel"
                          ItemTemplate="{StaticResource MessageTemplate}"
                          Padding="4,8"/>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════
             TYPING INDICATOR
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#12122A"
                Padding="16,4"
                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="StatusText"
                       Text="Copilot is thinking…"
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="#7B61FF"/>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             INPUT ROW
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#0E0E22" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Style="{StaticResource ChatInput}"
                         IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                         KeyDown="InputBox_KeyDown"/>

                <Button Grid.Column="1"
                        Content="Send ↑"
                        Style="{StaticResource PrimaryBtn}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                        Click="Send_Click"/>
            </Grid>
        </Border>

    </Grid>
</Page>
