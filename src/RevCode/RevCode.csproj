<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RevCode</RootNamespace>
    <AssemblyName>RevCode</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>Irfan Irwanuddin</Company>
    <Authors>Irfan Irwanuddin</Authors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Revit 2025 API References -->
  <PropertyGroup>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(RevitInstallDir)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Roslyn for runtime code compilation -->
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.9.2" />
  </ItemGroup>

  <!-- Embedded icon resources -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\icon32.png" />
    <EmbeddedResource Include="Resources\icon16.png" />
  </ItemGroup>

  <!-- Copy .addin manifest and default sample scripts to output -->
  <ItemGroup>
    <Compile Remove="DefaultScripts\*.cs" />
    <None Include="RevCode.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="DefaultScripts\*.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Move Roslyn DLLs to a libs/ sub-folder so they are NOT in the assembly
    probing root. This prevents the default AssemblyLoadContext from binding
    them before Dynamo (or other plugins) can load their own copy, which would
    cause "Assembly with same name is already loaded" when Dynamo calls
    Assembly.LoadFrom() on its Roslyn DLLs from a different path.
    App.cs registers an AssemblyResolve handler that loads from libs/ on demand.
  -->
  <Target Name="IsolateRoslynAssemblies" AfterTargets="Build">
    <ItemGroup>
      <RoslynToIsolate Include="$(OutputPath)Microsoft.CodeAnalysis.dll"        Condition="Exists('$(OutputPath)Microsoft.CodeAnalysis.dll')" />
      <RoslynToIsolate Include="$(OutputPath)Microsoft.CodeAnalysis.CSharp.dll"  Condition="Exists('$(OutputPath)Microsoft.CodeAnalysis.CSharp.dll')" />
      <!-- AvalonEdit is also shipped by Dynamo; keep it out of the probing root
           so the Default ALC doesn't bind our copy before Dynamo loads its own. -->
      <RoslynToIsolate Include="$(OutputPath)ICSharpCode.AvalonEdit.dll"         Condition="Exists('$(OutputPath)ICSharpCode.AvalonEdit.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)libs\" />
    <Move SourceFiles="@(RoslynToIsolate)" DestinationFolder="$(OutputPath)libs\" />
  </Target>

</Project>
