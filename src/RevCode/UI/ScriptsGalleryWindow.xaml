<Window x:Class="RevCode.UI.ScriptsGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevCode Scripts Gallery"
        Width="620" Height="540"
        MinWidth="480" MinHeight="360"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- Scrollbar style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#74C7EC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5EAFD8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (delete) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#F38BA8"/>
            <Setter Property="BorderBrush" Value="#F38BA8"/>
        </Style>

        <!-- Script card -->
        <Style x:Key="ScriptCard" TargetType="Border">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- TextBox search -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="CaretBrush" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Search bar -->
            <RowDefinition Height="*"/>      <!-- Script list -->
            <RowDefinition Height="Auto"/>   <!-- Status + bottom bar -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="#181825" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="RevCode Scripts Gallery"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#CDD6F4"/>
                    <TextBlock x:Name="ScriptCountText"
                               Text="0 scripts"
                               FontSize="11" Foreground="#6C7086"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="&#x1F4C2; New Script"
                            Style="{StaticResource PrimaryButton}"
                            Click="NewScript_Click"
                            ToolTip="Create a new blank script in the editor"
                            Margin="0,0,6,0"/>
                    <Button Content="&#x1F5C1; Open Folder"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenFolder_Click"
                            ToolTip="Open the scripts folder in File Explorer"
                            Margin="0,0,6,0"/>
                    <Button Content="&#x21BB; Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Click="Refresh_Click"
                            ToolTip="Reload scripts from folder"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Search bar ── -->
        <Border Grid.Row="1" Background="#1E1E2E" Padding="16,8">
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource SearchBox}"
                     Tag="Search scripts..."
                     TextChanged="SearchBox_TextChanged">
                <TextBox.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource SearchBox}"/>
                </TextBox.Resources>
            </TextBox>
        </Border>

        <!-- ── Script list ── -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,4">
            <StackPanel>

                <!-- Empty state -->
                <Border x:Name="EmptyState" Visibility="Collapsed"
                        Padding="0,40" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#x1F4C4;" FontSize="40"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="No scripts saved yet"
                                   FontSize="14" Foreground="#585B70"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4"/>
                        <TextBlock Text="Use &#x22;Save to Gallery&#x22; in the code editor to save a script here."
                                   FontSize="11" Foreground="#45475A"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Script cards container -->
                <ItemsControl x:Name="ScriptsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ScriptCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            Background="#45475A"
                                            CornerRadius="4"
                                            Width="28" Height="28"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="C#"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="#89B4FA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name + metadata -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#CDD6F4"/>
                                        <TextBlock Text="{Binding Meta}"
                                                   FontSize="10" Foreground="#6C7086"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="&#x25B6; Run"
                                                Style="{StaticResource PrimaryButton}"
                                                Tag="{Binding FilePath}"
                                                Click="RunScript_Click"
                                                Margin="0,0,4,0"
                                                ToolTip="Compile and run this script in Revit"/>
                                        <Button Content="&#x270F; Load"
                                                Style="{StaticResource SecondaryButton}"
                                                Tag="{Binding FilePath}"
                                                Click="LoadScript_Click"
                                                Margin="0,0,4,0"
                                                ToolTip="Open this script in the code editor"/>
                                        <Button Content="&#x1F5D1;"
                                                Style="{StaticResource DangerButton}"
                                                Tag="{Binding FilePath}"
                                                Click="DeleteScript_Click"
                                                ToolTip="Delete this script from the gallery"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Status bar ── -->
        <Border Grid.Row="3" Background="#181825" Padding="16,8">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           FontSize="11" Foreground="#6C7086"
                           VerticalAlignment="Center"/>
                <ProgressBar x:Name="RunProgress"
                             DockPanel.Dock="Right"
                             Width="120" Height="4"
                             Minimum="0" Maximum="100"
                             Background="#313244"
                             Foreground="#89B4FA"
                             BorderThickness="0"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="0,0,0,0"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
